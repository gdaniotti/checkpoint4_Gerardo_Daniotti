      "parameters": {
        "jsCode": "const raw = ($json.output || '').replace(/```json|```/g,'').trim();\nlet d;\ntry { d = JSON.parse(raw); } catch (e) {\n  d = { categoria:'consulta_general', urgencia:'media', resumen:'La IA no devolvió JSON válido: revisar a mano', borrador:'Hola, recibimos tu consulta. Una persona del equipo te va a responder a la brevedad.' };\n}\nconst ok = ['fraude_contracargo','kyc_pendiente','estado_credito','consulta_general'];\nif (!ok.includes(d.categoria)) d.categoria = 'consulta_general';\nif (!['alta','media','baja'].includes(d.urgencia)) d.urgencia = 'media';\nconst p = $('Limpiar y enmascarar').item.json;\nreturn [{ json: { ...p, ...d } }];"
      },
